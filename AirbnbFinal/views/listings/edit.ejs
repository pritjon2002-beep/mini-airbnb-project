<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>wanderlust</title>
</head>
<body>
    <h2><span style="
  display:inline-block;
  padding: 0 10px;
  border-bottom: 3px solid black;
">
  Edit Your New Listing
</span></h2>
 

    <form action="/listings/<%=listing._id %>?_method=PUT" method="POST" style="align-items: center;">
        <input name="listing[title]"  type="text" value="<%= listing.title %>" style="height: 50px; width: 50vw;" required><br><br>
        <textarea name="listing[description]" type="text"  style="height: 25vh; width: 50vw;" required> <%= listing.description %></textarea> <br><br>
        <input name="listing[image]" type="text" value="<%= listing.image %>"  style="height: 50px; width: 50vw;" ><br><br>
        <input name="listing[price]" type="number" value="<%= listing.price %>"  style="height: 50px; width: 50vw;" step="500" required><br><br>
        <input name="listing[location]" type="text" value="<%= listing.location %>" style="height: 50px; width: 50vw;" required><br><br>
        <input name="listing[country]" type="text" value="<%= listing.country %>"  style="height: 50px; width: 50vw;" required><br><br>
        <button style="height: 50px; width: 50vw; "  type="submit">Edit Listing</button>
    </form>
     <br><br><a href="/listings"><button>Listings</button></a>

</body>
</html>