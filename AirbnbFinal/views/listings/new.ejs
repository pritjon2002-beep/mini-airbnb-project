    <form action="/listings" method="post" style="align-items: center;">
        <input name="listing[title]" type="text" placeholder="Enter a good Title " style="height: 50px; width: 50vw;" required><br><br>
        <textarea name="listing[description]" type="text" placeholder="Enter suitable description " style="height: 25vh; width: 50vw;" required> </textarea> <br><br>
        <input name="listing[image]" type="text" placeholder="Enter image url " style="height: 50px; width: 50vw;" ><br><br>
        <input name="listing[price]" type="number" placeholder="Enter Price" style="height: 50px; width: 50vw;" step="500" required><br><br>
        <input name="listing[location]" type="text" placeholder="Enter location " style="height: 50px; width: 50vw;" required><br><br>
        <input name="listing[country]" type="text" placeholder="Enter Country " style="height: 50px; width: 50vw;" required><br><br>
        <button style="height: 50px; width: 50vw; " type="submit">Add Listing</button>
    </form>

