            <form action="/listings" method="post">

                <div class="mt-3">
                    <label for="title" class="form-label">Enter &nbsp; Title :</label>
                    <input name="listing[title]" type="text" placeholder="Enter a good Title " id="title"
                        class="form-control" required>
                </div>

                <div class="mt-3">
                    <label for="description" class="form-label">Enter &nbsp; Description :</label>
                    <textarea name="listing[description]" type="text" placeholder="Enter suitable description "
                        id="description" class="form-control" required> </textarea>
                </div>

                <div class="mt-3">
                    <label for="image" class="form-label"> Enter &nbsp; Image &nbsp; Link :</label>
                    <input id="image" class="form-control" name="listing[image]" type="text"
                        placeholder="Enter image url ">
                </div>
                <div class="row">
                <div class="mt-3 col-md-4">
                    <label for="price" class="form-label">Enter &nbsp; Price :</label>
                    <input id="price" class="form-control" name="listing[price]" type="number" placeholder="Enter Price"
                        step="500" required>
                    </div>
                    <div class="mt-3 col-md-8">
                        <label for="country" class="form-label">Enter &nbsp; Country :</label>
                        <input id="country" class="form-control" name="listing[country]" type="text"
                            placeholder="Enter Country " required>
                    </div>
                    </div>
                <div class="mt-3">
                    <label for="location" class="form-label">Enter &nbsp; Location :</label>
                    <input id="location" class="form-control" name="listing[location]" type="text"
                        placeholder="Enter location " required>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-danger  offset-2 mt-4" style="width: 30vw;" >Add Listing</button>
                </div>
            </form>
        </div>
    </div>