<% layout("/layouts/boilerplate.ejs") %>
<body>
  <div class="text-center">
    <h2 class="text-center mt-3 show-header">Listing Details : </h2>
  </div>
 
<div class="row">
  <div class="col-8 offset-2">
<div class="card " >
   <img src="<%= listing.image.url  %>" class=" show-img" alt="Listing_Image">
  <div class="card-body">
    <h5 class="card-title mt-3"><%= listing.title %></h5>
    <%= listing.description %> <br>
    &#8377 &nbsp;<%=  listing.price.toLocaleString("en-IN") %><br>
    <%= listing.location %><br>
    <%= listing.country %><br>
  </div>
</div>

<div class=" d-flex mt-3 pb-3">  
 <a href="/listings/<%= listing.id %>/edit"><button class="btn btn-danger">Edit Listing</button></a>
 <form action="/listings/<%= listing._id %>?_method=delete " method="post">
    <button class="btn btn-dark ms-2">
    Delete Listing
    </button>
 </form>
</div>


<hr>


<div class="col-8  mt-4 w-100" >
  <h4>Leave a Review : </h4>
  <div class="mt-2">
   <form action="/listings/<%= listing.id %>/reviews" method="post" class="needs-validation" novalidate>

    <div>
      <label for="rating" class="form-label mt-2">Rating</label>
      <input type="range" id="rating" min="1" max="5" name="review[rating]" class="form-range" >
    </div>

    <div >
      <label for="comment" class="form-label mt-2" >Describe Your Experience : </label>
      <textarea required name="review[comment]" id="comment" class="form-control" rows="6" cols="10" ></textarea>
      <div class="valid-feedback">Valid-READY TO SUBMIT</div>
      <div class="invalid-feedback">IT SHOULD NOT BE EMPTY</div>
    </div>
    

    <button class="btn btn-outline-dark mt-3" >Submit</button>
   </form>
  </div>

</div>

</div>

</body>
</html>