<% layout("/layouts/boilerplate.ejs") %>
<body>
  <div class="text-center">
    <h2 class="text-center mt-3 show-header">Listing Details : </h2>
  </div>
 
<div class="row">
  <div class="col-8 offset-2">
<div class="card " >
   <img src="<%= listing.image.url  %>" class=" show-img" alt="Listing_Image">
  <div class="card-body">
    <h5 class="card-title mt-3"><%= listing.title %></h5>
    <%= listing.description %> <br>
    &#8377 &nbsp;<%=  listing.price.toLocaleString("en-IN") %><br>
    <%= listing.location %><br>
    <%= listing.country %><br>
  </div>
</div>

<div class=" d-flex mt-3">  
 <a href="/listings/<%= listing.id %>/edit"><button class="btn btn-danger">Edit Listing</button></a>
 <form action="/listings/<%= listing._id %>?_method=delete " method="post">
    <button class="btn btn-dark ms-2">
    Delete Listing
    </button>
 </form>
</div>

<div class="col-8 offset-2 mt-4">
  <h4>Leave a Review : </h4>
  <div class="mt-2">
   <form action="">

    <div>
      <label for="rating">Rating</label>
      <input type="range" id="rating" min="1" max="5" name="review[rating]">
    </div>

    <div>
      <label for="comment">Describe Your Experience : </label>
      <textarea name="review[comment]" id="comment" ></textarea>
    </div>

    <button>Submit</button>
   </form>
  </div>

</div>

</div>

</body>
</html>