<% layout("/layouts/boilerplate.ejs") %>

<div class="show-wrapper">
  <h2 class="mt-3 mb-4">My Wishlist</h2>

  <% if(savedListings.length === 0) { %>
    <p>You haven't saved any listings yet.</p>
  <% } else { %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
      <% savedListings.forEach(listing => { %>
        <div class="col">
          <a href="/listings/<%= listing._id %>" style="text-decoration:none; color:inherit;">
            <div class="card listing-card">
              <img src="<%= listing.image.url %>" class="card-img-top" alt="Listing Image">
              <div class="card-body">
                <p class="card-text"><%= listing.title %></p>
                <p class="card-text">₹<%= listing.price.toLocaleString("en-IN") %></p>
              </div>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>