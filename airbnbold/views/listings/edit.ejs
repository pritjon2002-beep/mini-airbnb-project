<% layout('layouts/boilerplate') %>

  <body>
    <form action="/listing/<%= listing._id %>?_method=PUT" method="post" class="mt-3 needs-validation" novalidate>

      <div class="mb-3">
        <label for="t" class="form-label"> Title: </label>
        <input type="text" value=" <%= listing.title %>" id="t" name="listing[title]" class="form-control" required>
          <div class="invalid-feedback">
      Please provide a valid tittle.
    </div>
      <div class="valid-feedback">
    valid for edit
    </div>
      </div>

      <div class="mb-3">
        <label for="d" class="form-label"> Description: </label> <br>
        <textarea type="text" id="d" name="listing[description]" class="form-control" required><%= listing.description %></textarea>

            <div class="invalid-feedback">
      Please provide a valid description.
    </div>

      <div class="valid-feedback">
    valid for edit
    </div>
      </div>

  <div class="mb-3">
        <label for="ti" class="form-label"> Image: </label>
        <input type="image" value=" <%= listing.image %>" id="ti" name="listing[image]" class="form-control" required>
          <div class="invalid-feedback">
      Please provide a valid image url.
    </div>
      <div class="valid-feedback">
    valid for edit
    </div>
      </div>


      <div class="row">
        <div class="mb-3 col-md-4">

          <label for="p" class="form-label"> Price: </label>
          <input type="number" id="p" value="<%= listing.price %>" class="form-control" name="listing[price]" required>

          
            <div class="invalid-feedback">
      Please provide a valid price.
    </div>

      <div class="valid-feedback">
    valid for edit
    </div>

        </div>

        <div class="mb-3 col-md-8">
          <label for="c" class="form-label"> Country: </label>
          <input type="text" id="c" value="  <%= listing.country %>" class="form-control" name="listing[country]" required>

          
            <div class="invalid-feedback">
      Please provide a valid country name.>

      <div class="valid-feedback">
    valid for edit
    </div>

        </div>
      </div>

      <div class="mb-3">
        <label for="l" class="form-label"> Location: </label>
        <input type="text" id="l" value=" <%= listing.location %>" class="form-control" name="listing[location]" required>

        
            <div class="invalid-feedback">
      Please provide a valid location.
    </div>

      <div class="valid-feedback">
    valid for edit
    </div>

      </div>



      <button class="btn btn-dark mb-3">Submit</button>

    </form>

  </body>