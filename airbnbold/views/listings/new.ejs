<% layout('layouts/boilerplate') %>

<body>
    <br><br>
    <div class="row">
        <div class="col-8 offset-2">

      
    <form action="/listing/new" method="post" novalidate class="needs-validation">
    <div class="mb-3">  
          <label for="t" class="form-label">Enter Title: </label>
        <input type="text" placeholder="enter title" id="t" name="listing[title]" class="form-control " required> 
      <div class="invalid-feedback">
      Please provide a valid tittle.
    </div>
      <div class="valid-feedback">
     this tittle looks good
    </div>
    </div>

      <div class="mb-3">
          <label for="d" class="form-label" >Add Description: </label> <br>
        <textarea type="text" id="d" placeholder="enter description" name="listing[description]"   class="form-control " required></textarea>
     
        <div class="valid-feedback">
     this discription looks good
    </div>
    
    <div class="invalid-feedback">
      Please provide a valid discription.
    </div>  
    
    </div>


   <div class="row">
       <div class="mb-3 col-md-4">
          
          <label for="p" class="form-label">Enter Price: </label>
          <input type="number" id="p" placeholder="enter price"  class="form-control " name="listing[price]" required>
     <div class="valid-feedback">
     this tittle is valid
    </div>
      <div class="invalid-feedback">
      Please provide a valid price.
    </div>
 </div>
      
      <div class="mb-3 col-md-8">
          <label for="c" class="form-label">Enter Country: </label>
   <input type="text" id="c" placeholder="enter country"  class="form-control " name="listing[country]" required>
 <div class="valid-feedback">
     valid country name</div>
     <div class="invalid-feedback">
      Please provide a valid country.
    </div>
      </div >
   </div>

      <div class="mb-3">
          <label for="l" class="form-label">Enter Location: </label>
          <input type="text" id="l" placeholder="enter location"  class="form-control " name="listing[location]" required>
 
          <div class="valid-feedback">
     valid location
    </div>
    
    <div class="invalid-feedback">
      Please provide a valid location.
    </div>
      </div>

 <button type="submit" class="btn btn-dark">Enter</button>
    </form>
      </div>
    </div>
    <br><br>
</body>
