<% layout('layouts/boilerplate') %>

   <body>




      <div class="row mt-3">
         <div class="cols-8 offset-2">
            <h2>
               <%=listing.title %>
            </h2>
         </div>

         <div class="card col-6 offset-2">
            <img src="<%= listing.image %>" class="card-img-top show-image" alt="listing_image">

            <div class="card-body">
               <p class="card-text mt-1"><b>
                     Title: <%= listing.title %></b> <br>
                  <b>Description: <%= listing.description %> </b>
                  <b>Price: &#8377 <%= listing.price.toLocaleString("en-IN") %></b><br>
                  <b> Location: <%= listing.location %> </b> <br>
                  <b> Country <%= listing.country %> </b> <br>
               </p>

               <div class="row justify-content-center my-4">
                  <div class="col-8">
                     <div class="row text-center g-2">

                        <div class="col-6">
                           <form action="/listing/<%= listing._id %>/edit" method="get">
                              <button class="btn btn-dark w-100">Edit</button>
                           </form>
                        </div>

                        <div class="col-6">
                           <form action="/listing/<%= listing._id %>?_method=delete" method="post"
                              onsubmit="return confirm('Are you sure to delete?')">
                              <button type="submit" class="btn btn-danger w-100">Delete</button>
                           </form>
                        </div>



                     </div>
                  </div>
               </div>
            </div>
         </div>
      </div>


      <div class="col-8 offset-3 mx-auto">
         <h3><b>Leave a Review!</b></h3>
         <form action="/listing/<%= listing.id %>/reviews" method="post" novalidate class="needs-validation">
            <div>
               <label for="rating " class="mt-1 ">Rating : </label>
               <input class="form-range " type="range" min="1" max="5" name="review[rating]">

            </div>

            <div>
               <label for="comment" class="form-label mt-3">Comment : </label>
               <textarea class="form-control " name="review[comment]" id="comment" rows="10" cols="60"
                  placeholder="Describe Your Expreience" required></textarea>

                  <div class="invalid-feedback">
                     Comment Is Required . So please add comment as your experience
                  </div>
            </div>

            <div class="text-center">
               <button class="btn btn-dark w-50   mt-3">
                  Submit Review
               </button>
            </div>
         </form>
         <br>

         <div>
            <h2>
               All Review
            </h2>
            <p> <%= listing.reviews %> </p>
         </div>
      </div>







   </body>