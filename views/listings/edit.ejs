<% layout('layouts/boilerplate') %>

<body>
  <form action="/listing/<%= listing._id %>?_method=PUT" method="post" class="mt-3">
 
     <div class="mb-3">  
          <label for="t" class="form-label"> Title: </label>
        <input type="text" value=" <%= listing.title %>" id="t" name="title" class="form-control"> 
    </div>
     
 <div class="mb-3">
          <label for="d" class="form-label" > Description: </label> <br>
        <textarea type="text" id="d"  name="description0"   class="form-control" ><%= listing.description %></textarea>
      </div>

   <div class="row">
       <div class="mb-3 col-md-4">
          
          <label for="p" class="form-label"> Price: </label>
          <input type="number" id="p" placeholder=" <%= listing.price %> "  class="form-control" name="price">
      </div>
      
      <div class="mb-3 col-md-8">
          <label for="c" class="form-label"> Country: </label>
   <input type="text" id="c" value="  <%= listing.country %>"  class="form-control" name="country">

      </div >
   </div>

      <div class="mb-3">
          <label for="l" class="form-label"> Location: </label>
          <input type="text" id="l" value=" <%= listing.location %>"  class="form-control" name="location">

      </div>



    <button class="btn btn-dark mb-3">Submit</button>

  </form>

</body>
