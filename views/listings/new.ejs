<% layout('layouts/boilerplate') %>

<body>
    <br><br>
    <div class="row">
        <div class="col-8 offset-2">

      
    <form action="/listing/new" method="post">
    <div class="mb-3">  
          <label for="t" class="form-label">Enter Title: </label>
        <input type="text" placeholder="enter title" id="t" name="title" class="form-control"> 
    </div>

      <div class="mb-3">
          <label for="d" class="form-label" >Add Description: </label> <br>
        <textarea type="text" id="d" placeholder="enter description" name="description"   class="form-control" ></textarea>
      </div>

   <div class="row">
       <div class="mb-3 col-md-4">
          
          <label for="p" class="form-label">Enter Price: </label>
          <input type="number" id="p" placeholder="enter price"  class="form-control" name="price">
      </div>
      
      <div class="mb-3 col-md-8">
          <label for="c" class="form-label">Enter Country: </label>
   <input type="text" id="c" placeholder="enter country"  class="form-control" name="country">

      </div >
   </div>

      <div class="mb-3">
          <label for="l" class="form-label">Enter Location: </label>
          <input type="text" id="l" placeholder="enter location"  class="form-control" name="location">

      </div>

 <button type="submit" class="btn btn-dark">Enter</button>
    </form>
      </div>
    </div>
    <br><br>
</body>
