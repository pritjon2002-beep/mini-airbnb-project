<% layout('layouts/boilerplate') %>

   <body>




      <div class="row mt-3">
         <div class="cols-8 offset-2">
            <h2>
               <%=listing.title %>
            </h2>
         </div>

         <div class="card col-6 offset-2">
            <img src="<%= listing.image %>" class="card-img-top show-image" alt="listing_image">

            <div class="card-body">
               <p class="card-text mt-1"><b>
                     Title: <%= listing.title %></b> <br>
                  <b>Description: <%= listing.description %> </b>
                  <b>Price: &#8377 <%= listing.price.toLocaleString("en-IN") %></b><br>
                  <b> Location: <%= listing.location %> </b> <br>
                  <b> Country <%= listing.country %> </b> <br>
               </p>

               <div class="row justify-content-center my-4">
                  <div class="col-8">
                     <div class="row text-center g-2">

                        <div class="col-6">
                           <form action="/listing/<%= listing._id %>/edit" method="get">
                              <button class="btn btn-dark w-100">Edit</button>
                           </form>
                        </div>

                        <div class="col-6">
                           <form action="/listing/<%= listing._id %>?_method=delete" method="post"
                              onsubmit="return confirm('Are you sure to delete?')">
                              <button type="submit" class="btn btn-danger w-100">Delete</button>
                           </form>
                        </div>

                     </div>
                  </div>
               </div>
            </div>
         </div>
      </div>







   </body>